font-family = monospace
font-size = 13
scrollback-limit = 50000000
clipboard-read = allow

# Keep window decorations enabled for AeroSpace to access the close button.
window-decoration = true
macos-titlebar-style = hidden
macos-window-buttons = hidden
window-inherit-working-directory = true
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m

background = 1e1e2e
foreground = cdd6f4
cursor-color = f5e0dc
cursor-text = 74c7ec
selection-background = 585b70
selection-foreground = cdd6f4

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#cba6f7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#cba6f7
palette = 14=#94e2d5
palette = 15=#a6adc8

# Copy/Paste standard terminal keybindings.
keybind = performable:ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = cmd+shift+enter=new_window

# Disable native macOS Command+C / Command+V copy-paste inside Ghostty to
# enforce standard Linux Terminal habits (Ctrl+Shift+C/V).
keybind = cmd+c=unbind
keybind = cmd+v=unbind

# Linux-style Ctrl word deletion and navigation.
keybind = ctrl+backspace=text:\x1b\x7f
keybind = ctrl+left=esc:b
keybind = ctrl+right=esc:f

# Unbind default super+d / super+shift+d splits to prevent accidental triggers.
keybind = super+d=unbind
keybind = super+shift+d=unbind
