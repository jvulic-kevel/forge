{
  "title": "Linux-style Keyboard Shortcuts",
  "rules": [
    {
      "description": "Map Ctrl+C/V/X/A/Z/S/F/W/T and Ctrl+Backspace/Arrows to match Linux behaviors (excluding terminal apps)",
      "manipulators": [
        {
          "description": "Ctrl+C to Cmd+C (Copy)",
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": [
                "control"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "c",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^org\\.alacritty$",
                "^com\\.microsoft\\.rdc.*",
                "^com\\.vmware\\.fusion$",
                "^com\\.parallels\\.desktop$"
              ]
            }
          ]
        },
        {
          "description": "Ctrl+V to Cmd+V (Paste)",
          "type": "basic",
          "from": {
            "key_code": "v",
